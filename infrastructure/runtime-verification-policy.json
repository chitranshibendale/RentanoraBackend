{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendVerificationEmails",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:us-east-1:070389302498:identity/rentanora.com",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "no-reply@rentanora.com"
        }
      }
    },
    {
      "Sid": "AccessVerificationRecords",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:070389302498:table/rentanora-contact-verification"
    },
    {
      "Sid": "ReadVerificationHashSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-1:070389302498:secret:rentanora-contact-verification-otp-key-d14pdV"
    }
  ]
}